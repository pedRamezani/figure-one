{
	"name": "figure-one",
	"private": true,
	"license": "MIT",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"gen": "wrangler types",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"lint-staged": {
		"*.{js,mjs,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,jsonc,css,md,yml,yaml,html}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@internationalized/date": "^3.10.0",
		"@sveltejs/adapter-cloudflare": "^7.2.6",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"isomorphic-dompurify": "^2.25.0",
		"jsrepo": "^3.0.10",
		"lint-staged": "^16.4.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"runed": "^0.36.0",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.63.0"
	},
	"dependencies": {
		"@dagrejs/dagre": "^1.1.8",
		"@lucide/svelte": "^0.562.0",
		"@myriaddreamin/typst-ts-renderer": "^0.6.1-rc5",
		"@myriaddreamin/typst-ts-web-compiler": "^0.6.1-rc5",
		"@myriaddreamin/typst.ts": "^0.6.1-rc5",
		"@shikijs/langs": "^3.21.0",
		"@shikijs/themes": "^3.21.0",
		"@xyflow/svelte": "^1.4.2",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"shiki": "^3.21.0",
		"zod": "^4.6.2"
	}
}
